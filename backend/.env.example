NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skilllink?replicaSet=rs0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2: disabled keeps auth/catalog available without cloud credentials.
MEDIA_PROVIDER=disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 catalog/verification transactions need a replica set.
# Local example after initializing rs0:
# MONGODB_URI=mongodb://127.0.0.1:27017/skilllink?replicaSet=rs0

# Phase 3: integer search radii in kilometres, maximum configurable cap 500.
DISCOVERY_DEFAULT_RADIUS_KM=25
DISCOVERY_MAX_RADIUS_KM=200

# Phase 4 temporary unpaid slot reservation
BOOKING_RESERVATION_MINUTES=15

# SIMULATED ONLY; 1000 basis points = 10% commission
PAYMENT_PROVIDER=mock
COMMISSION_BASIS_POINTS=1000

# No outbound email by default. An injected provider can supplement notifications.
EMAIL_PROVIDER=disabled
# Set only to the verified number of reverse proxy hops; never trust arbitrary forwarded IPs.
TRUST_PROXY_HOPS=0
