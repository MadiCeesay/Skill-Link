NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skilllink?replicaSet=rs0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173

# Phase 2: disabled keeps auth/catalog available without cloud credentials.
MEDIA_PROVIDER=disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 catalog/verification transactions need a replica set.
# Local example after initializing rs0:
# MONGODB_URI=mongodb://127.0.0.1:27017/skilllink?replicaSet=rs0

# Phase 3: integer search radii in kilometres, maximum configurable cap 500.
DISCOVERY_DEFAULT_RADIUS_KM=25
DISCOVERY_MAX_RADIUS_KM=200

# Phase 4 temporary unpaid slot reservation
BOOKING_RESERVATION_MINUTES=15

# Payments: mock = simulated (default, used by tests); modempay = Modem Pay checkout.
# 1000 basis points = 10% commission
PAYMENT_PROVIDER=mock
# Modem Pay test keys from the Modem Pay dashboard (sk_test_...). Never commit real keys.
MODEMPAY_SECRET_KEY=
MODEMPAY_WEBHOOK_SECRET=
# GMD = whole dalasi (default) or BUTUT if Modem Pay expects the smallest unit
MODEMPAY_AMOUNT_UNIT=GMD
# Public URL of this API so Modem Pay can send webhooks (leave empty on localhost)
PUBLIC_API_URL=
COMMISSION_BASIS_POINTS=1000

# No outbound email by default. An injected provider can supplement notifications.
EMAIL_PROVIDER=disabled
# Set only to the verified number of reverse proxy hops; never trust arbitrary forwarded IPs.
TRUST_PROXY_HOPS=0

# Operator-only: npm run seed:admin (never add ADMIN_* to frontend variables).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Optional; without it, new admins get a deterministic non-contact placeholder.
ADMIN_PHONE_NUMBER=

# Optional AI job description assistant (Google Gemini). Leave the key empty to switch it off.
# Create a key at https://aistudio.google.com. Never commit the real key.
GEMINI_API_KEY=
# Preferred model first, then backups used when Google reports it busy.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# Optional automatic voice-note transcripts (ElevenLabs Scribe). Leave the key empty to switch off.
# Create a key with Speech to Text permission at https://elevenlabs.io. Never commit the real key.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2,scribe_v1
